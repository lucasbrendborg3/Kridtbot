<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro"  name="robot">

    <!-- Arguments -->
    <xacro:arg name="use_sim_system" default="false"/>
    <xacro:arg name="active_suspension" default="false"/>
    <xacro:arg name="use_odrive" default="false"/>
    <xacro:arg name="mock_left_wheels" default="false"/>
    <xacro:arg name="mock_right_wheels" default="false"/>

    <!-- URDF Robot Description-->
    <xacro:include filename="robot_core.xacro" />
    
    <!-- Sensors -->
    <xacro:include filename="lidar.xacro" />
    <xacro:include filename="depth_camera.xacro" />
    <xacro:include filename="imu.xacro" /> 

    <!-- Control -->
    <xacro:if value="$(arg use_sim_system)">
        <xacro:include filename="ros2_control_gz.xacro" />
    </xacro:if>
    <xacro:unless value="$(arg use_sim_system)">
        <xacro:include filename="ros2_control_myactuator.xacro"/>
        <xacro:if value="$(arg use_odrive)">
            <xacro:include filename="ros2_control_odrive.xacro" />
        </xacro:if>
    </xacro:unless>

</robot> 